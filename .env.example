# Порт, на котором слушает сервер. Хостинг обычно сам подставляет PORT.
PORT=3000

# Ключевое слово для входа на панель. Без него /api не отдаст ничего.
RC_KEYWORD=aboba

# Секрет подписи JWT. ОБЯЗАТЕЛЬНО замените на случайную строку перед деплоем,
# иначе токены будут подписываться публичным дефолтом.
JWT_SECRET=замени_на_случайную_строку

# Опциональный TLS (https/wss) для работы через интернет.
# Укажите пути к PEM-файлам сертификата и ключа. Пусто — обычный http/ws.
#RC_CERT=./cert.pem
#RC_KEY=./key.pem
